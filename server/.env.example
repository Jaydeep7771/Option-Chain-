# Copy this file to .env and fill in real values.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# Upstox API (real option-chain data) — create an app at account.upstox.com/developer/apps
# Redirect URI must be: http://localhost:5000/api/upstox/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:5000/api/upstox/callback
UPSTOX_ACCESS_TOKEN=

PORT=5000

# ── Optional tuning (sensible FREE-TIER defaults; no billing needed) ──────────
# Reasoning models (ladder: primary, then fallback). Defaults are free/high-quota.
# SYNTHESIS_MODEL=gemini-2.0-flash
# SYNTHESIS_FALLBACK_MODEL=gemini-2.0-flash-lite
# News worker cadence + per-cycle embed cap — keep under the 1000/day free embed quota.
# NEWS_REFRESH_CRON=0 * * * *
# NEWS_EMBED_CAP=25
